# Copy to local.env; edit absolute paths. Do not commit local.env.
# Both hosts: path to the full Kimodo model repository (not this folder).
export KIMODO_PROJECT_ROOT=/path/to/kimodo-policy
# Server interpreter (server host only).
export KIMODO_SERVER_PYTHON=/path/to/conda/envs/kimodo-server/bin/python
# Workstation interpreters. Do not install these dependencies into the server environment.
export TELEOP_PYTHON=/path/to/conda/envs/kimodo-teleop/bin/python
export COLLECTION_PYTHON=/path/to/conda/envs/kimodo-collection/bin/python
export ROBOT_INTERFACE=your_robot_nic
export PICO_INTERFACE=your_pico_nic
export CAMERA_HOST=your_robot_camera_address
export KIMODO_SERVER_SSH=your_server_ssh_alias
# Optional; paths default to external/ and runtime/ under this clone.
# export WBC_ROOT=/absolute/path/to/GR00T-WholeBodyControl
# export SONIC_NATIVE_ROOT=/absolute/path/to/native

# Optional HTTP port; use the same value on both hosts.
# export KIMODO_PORT=18080
