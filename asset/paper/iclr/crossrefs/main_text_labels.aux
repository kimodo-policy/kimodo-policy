\newlabel{fig:overview}{{1}{1}{\textbf {Overview of Kimodo-Policy.} Top: diverse VLA pretraining adapts T2M priors through three-stage root--body--hand generation for visually grounded control. Bottom: skeletal history conditions action-chunk prediction; real-world examples illustrate coordinated whole-body execution}{figure.1}{}}
\newlabel{sec:introduction}{{1}{2}{Introduction}{section.1}{}}
\newlabel{fig:policy_routes}{{2}{2}{\textbf {Comparison of Humanoid Policy Architectures.} Panels (a)--(c) contrast VLM-based, VGM-based, and our T2M-based policy backbones. Panels (d)--(f) illustrate unified whole-body generation, hybrid generation of upper-body joint targets and lower-body locomotion commands, and our hierarchical root--body--hand generation, respectively}{figure.2}{}}
