\newlabel{fig:pretraining_datasets}{{9}{2}{\textbf {Composition of the VLA Pretraining Corpus.} The corpus combines HIW-500, 14 task subsets from UniFoLM-WBT available when the corpus was assembled, and Humanoid Everyday. UniFoLM-WBT entries released after corpus construction are excluded}{figure.9}{}}
\newlabel{sec:setup_posttraining}{{B.2}{3}{Post-Training}{subsection.B.2}{}}
\newlabel{fig:real_world_setup}{{10}{3}{\textbf {Real-World Data Collection and Motion Profiles.} Left: PICO-based whole-body teleoperation of the humanoid. Right: measured (solid) and commanded (dashed) left- and right-side mean joint positions for two of the eight physical-robot tasks: (a) Football Scoring, showing a pronounced right-leg change during the kick, and (b) Banana Cabinet, showing motion across the pick, place, and push phases}{figure.10}{}}
\newlabel{sec:task_visualizations}{{C}{4}{Task Visualizations}{appendix.C}{}}
\newlabel{sec:vis_humanoidarena}{{C.1}{4}{HumanoidArena Tasks}{subsection.C.1}{}}
\newlabel{fig:humanoidarena}{{11}{4}{\textbf {Visualization of the Seven HumanoidArena Tasks.} The benchmark includes Football, DoubleDesk, P\&Pbox, OpenDoor, SitSofa, Boxing, and VisNavi, covering language-conditioned humanoid behavior across human--object and human--scene interaction with coordinated locomotion, balance, and manipulation}{figure.11}{}}
\newlabel{sec:vis_simple}{{C.2}{4}{SIMPLE Tasks}{subsection.C.2}{}}
\newlabel{fig:simple_tasks}{{12}{5}{\textbf {Evaluated SIMPLE Task Suite.} The selected tasks cover object handover and mobile pick-and-place, locomotion-integrated object pickup, articulated-object interaction, and household-object manipulation. Panels show (a) Handover, (b) Mobile P\&P, (c) XMoveBendPick, (d) CloseDoor, (e) OpenOven, (f) OpenFaucet, (g) Push Office Chair, and (h) OpenTrashCan}{figure.12}{}}
\newlabel{sec:vis_real_world}{{C.3}{5}{Real-World Tasks}{subsection.C.3}{}}
\newlabel{fig:real_world}{{13}{5}{\textbf {Examples of Real-World Humanoid Manipulation.} The image shows representative interaction scenarios involving articulated objects, object transport, and coordinated whole-body motion}{figure.13}{}}
