\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces \textbf  {Training Dynamics and Ablation Performance.} Left: training-loss trajectories for the trained and no-training settings. Right: mean task success across DoubleDesk, Football, and P\&Pbox. Gray bars show component and training-design ablations: removing the T2M backbone (w/o T2M), unfreezing it (w/o Frozen), replacing MSE with the original Kimodo motion loss (w/o MSE), and removing root--body gradient detachment (w/o Detach). The VLA-pretraining comparison is shown separately in light blue (w/o Pretrain) and dark blue (Ours$^{*}$).}}{16}{figure.caption.17}\protected@file@percent }
\newlabel{fig:training_loss_comparison}{{13}{16}{\textbf {Training Dynamics and Ablation Performance.} Left: training-loss trajectories for the trained and no-training settings. Right: mean task success across DoubleDesk, Football, and P\&Pbox. Gray bars show component and training-design ablations: removing the T2M backbone (w/o T2M), unfreezing it (w/o Frozen), replacing MSE with the original Kimodo motion loss (w/o MSE), and removing root--body gradient detachment (w/o Detach). The VLA-pretraining comparison is shown separately in light blue (w/o Pretrain) and dark blue (Ours$^{*}$)}{figure.caption.17}{}}
