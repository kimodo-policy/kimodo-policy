\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Overview of Kimodo-Policy.} The colored vertical blocks denote \inlinecolorblock  {green!55!black}{green!15} ``frozen Kimodo-Root and Kimodo-Body denoisers,'' \inlinecolorblock  {blue!55!black}{blue!10} ``trainable ControlNet-Root and ControlNet-Body branches injecting DINOv3~\cite  {dinov3} features,'' and \inlinecolorblock  {gray!65}{gray!15} ``trainable HandNet denoiser for bilateral hand control.'' Dual-Path Fusion combines motion-query cross-attention with an MLP-based mapping from spatial visual tokens to the future horizon. The predicted root conditions body generation, while future body features condition HandNet; the Motion Projector converts root--body predictions into tracker references. Snowflakes and flames mark frozen and trainable modules, respectively, and dashed boxes indicate Dual-Path Fusion.}}{6}{figure.caption.3}\protected@file@percent }
\newlabel{fig:method_architecture}{{3}{6}{\textbf {Overview of Kimodo-Policy.} The colored vertical blocks denote \inlinecolorblock {green!55!black}{green!15} ``frozen Kimodo-Root and Kimodo-Body denoisers,'' \inlinecolorblock {blue!55!black}{blue!10} ``trainable ControlNet-Root and ControlNet-Body branches injecting DINOv3~\cite {dinov3} features,'' and \inlinecolorblock {gray!65}{gray!15} ``trainable HandNet denoiser for bilateral hand control.'' Dual-Path Fusion combines motion-query cross-attention with an MLP-based mapping from spatial visual tokens to the future horizon. The predicted root conditions body generation, while future body features condition HandNet; the Motion Projector converts root--body predictions into tracker references. Snowflakes and flames mark frozen and trainable modules, respectively, and dashed boxes indicate Dual-Path Fusion}{figure.caption.3}{}}
\newlabel{eq:three_stage_architecture}{{5}{6}{Model Architecture}{equation.5}{}}
