\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Motion-Prior Transfer for Closed-Loop Control.} Top: frozen Kimodo generates a complete ``Sit on the sofa'' sequence from text alone. Bottom: Kimodo-Policy grounds the same prior with visual observations and motion history, repeatedly predicting short action chunks for closed-loop execution. Light-brown poses denote observed history; blue poses denote predicted and executed motion.}}{7}{figure.caption.4}\protected@file@percent }
\newlabel{fig:t2m_transfer}{{4}{7}{\textbf {Motion-Prior Transfer for Closed-Loop Control.} Top: frozen Kimodo generates a complete ``Sit on the sofa'' sequence from text alone. Bottom: Kimodo-Policy grounds the same prior with visual observations and motion history, repeatedly predicting short action chunks for closed-loop execution. Light-brown poses denote observed history; blue poses denote predicted and executed motion}{figure.caption.4}{}}
