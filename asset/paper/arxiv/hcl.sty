%% HCL preprint style -- Humanoid Computing Lab, HKUST(GZ).
%% Adapted from the PolyU VCLab Authoring Toolkit (2026).
%% Usage: \usepackage{hcl}; XeLaTeX/system fonts: \usepackage[xetex]{hcl}.
%% Branding: \setUniversityLogo, \setHCLLogo, \setReportTag.
%% Title: \maketitleHCL. Boxes: hclAbstract and hclNote.
%% Keep the logo/ directory alongside the main .tex file.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{hcl}[2026/09/02 v1.0 HCL preprint style]

%---------------------------------------------------------------------------
% Options
%---------------------------------------------------------------------------
\newif\ifhcl@xetex      \hcl@xetexfalse
\newif\ifhcl@accepted   \hcl@acceptedfalse
\newif\ifhcl@nologos    \hcl@nologosfalse

\DeclareOption{xetex}{\hcl@xetextrue}
\DeclareOption{pdftex}{\hcl@xetexfalse}
\DeclareOption{accepted}{\hcl@acceptedtrue}
\DeclareOption{nologos}{\hcl@nologostrue}
\DeclareOption*{}
\ProcessOptions\relax

%---------------------------------------------------------------------------
% Core packages
%---------------------------------------------------------------------------
\RequirePackage[T1]{fontenc}
\ifhcl@xetex
  \RequirePackage{fontspec}
  % Users can override with their own \setmainfont
\else
  \RequirePackage[utf8]{inputenc}
  \RequirePackage{newtxtext}
  \RequirePackage{newtxmath}
\fi

\RequirePackage[a4paper,
                top=1.7cm, bottom=1.7cm,
                left=2.1cm, right=2.1cm,
                headheight=1.2cm, headsep=0.2cm,
                footskip=0.75cm]{geometry}

\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{calc,shadings,shapes.geometric}
\RequirePackage[most]{tcolorbox}
\tcbuselibrary{skins}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{caption}
\RequirePackage{enumitem}
\RequirePackage{microtype}
\RequirePackage{etoolbox}
\RequirePackage{lastpage}
\RequirePackage{ragged2e}
\RequirePackage{hyperref}
\RequirePackage{url}
\urlstyle{same}

% Paragraph layout: flush-left paragraphs separated by a small vertical gap.
% This keeps the manuscript readable without relying on first-line indentation.
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.45em plus 0.08em minus 0.04em}

%---------------------------------------------------------------------------
% Brand colors (HKUST(GZ) navy blue)
%---------------------------------------------------------------------------
\definecolor{hclblue}{HTML}{003366}
\definecolor{hclbrown}{HTML}{996600}
\definecolor{hclbluedark}{HTML}{00264D}
\definecolor{hclbluesoft}{HTML}{336699}
\definecolor{hclgold}{HTML}{D4A24C}
\definecolor{hclgoldsoft}{HTML}{E8C685}
\definecolor{hclink}{HTML}{1A1A1A}
\definecolor{hclinksoft}{HTML}{333333}
\definecolor{hclmuted}{HTML}{6B6B6B}
\definecolor{hclmutedtwo}{HTML}{9A9A9A}
\definecolor{hclline}{HTML}{DCE5EF}
\definecolor{hcllinestrong}{HTML}{B9C9DB}
\definecolor{hclbg}{HTML}{F8FAFC}
\definecolor{hclbgalt}{HTML}{EDF3F8}
\definecolor{hclbgsoft}{HTML}{F3F7FB}

\hypersetup{
  colorlinks=true,
  linkcolor=hclbluedark,
  citecolor=hclbluedark,
  urlcolor=hclblue,
  filecolor=hclblue,
  pdfborderstyle={/S/U/W 1},
}

%---------------------------------------------------------------------------
% Logo paths (override before \maketitleHCL if needed)
%---------------------------------------------------------------------------
\newcommand{\hcl@universitylogo}{logo/HKUST-GZ.pdf}
\newcommand{\hcl@hcllogo}{logo/HCL.png}
\newcommand{\setUniversityLogo}[1]{\renewcommand{\hcl@universitylogo}{#1}}
\newcommand{\setHCLLogo}[1]{\renewcommand{\hcl@hcllogo}{#1}}

%---------------------------------------------------------------------------
% Text storage for the title block
%---------------------------------------------------------------------------
\newcommand{\hcl@eyebrow}{HCL\,\textbullet\,Preprint}
\newcommand{\setEyebrow}[1]{\renewcommand{\hcl@eyebrow}{#1}}

\newcommand{\hcl@reporttag}{Humanoid Computing Lab\,\textperiodcentered\,HKUST(GZ)}
\newcommand{\setReportTag}[1]{\renewcommand{\hcl@reporttag}{#1}}

% Light-coloured watermark-style tagline sitting between the two logos in
% the page header band. Single line, light blue caps, sans-serif.
\newcommand{\hcl@headertop}{}
\newcommand{\setHeaderTagline}[1]{\renewcommand{\hcl@headertop}{#1}}

\newcommand{\hcl@papertitle}{Paper Title}
\newcommand{\papertitle}[1]{\renewcommand{\hcl@papertitle}{#1}}

\newcommand{\hcl@papersubtitle}{}
\newcommand{\papersubtitle}[1]{\renewcommand{\hcl@papersubtitle}{#1}}

\newcommand{\hcl@authors}{}
\newcommand{\paperauthors}[1]{\renewcommand{\hcl@authors}{#1}}

\newcommand{\hcl@affil}{}
\newcommand{\paperaffil}[1]{\renewcommand{\hcl@affil}{#1}}

\newcommand{\hcl@notes}{}
\newcommand{\papernotes}[1]{\renewcommand{\hcl@notes}{#1}}

\newcommand{\hcl@badges}{}
\newcommand{\paperbadges}[1]{\renewcommand{\hcl@badges}{#1}}

\newcommand{\hcl@teaser}{}
\newcommand{\paperteaser}[1]{\renewcommand{\hcl@teaser}{#1}}

%---------------------------------------------------------------------------
% Author/affiliation marker helpers
%---------------------------------------------------------------------------
\newcommand{\equalmark}{\textsuperscript{\(\star\)}}
\newcommand{\correspondmark}{\textsuperscript{\(\dagger\)}}
\newcommand{\projleadmark}{\textsuperscript{\(\ddagger\)}}
\newcommand{\affilmark}[1]{\textsuperscript{\textcolor{hclblue}{\bfseries #1}}}

%---------------------------------------------------------------------------
% Pill-shaped project badge
%   \hclbadge{label}{url}
%   \hclbadge[color]{label}{url}
%---------------------------------------------------------------------------
\newcommand{\hclbadge}[3][hclblue]{%
  \tcbox[
    on line,
    nobeforeafter,
    enhanced,
    tcbox raise base,
    colback=white,
    colframe=#1,
    boxrule=0.55pt,
    arc=8pt, outer arc=8pt,
    left=6pt, right=6pt, top=1.6pt, bottom=0pt,
    fontupper=\footnotesize\sffamily\bfseries\color{#1},
  ]{\href{#3}{\strut#2}}%
}

% Filled (solid) variant - useful for the headline badge
\newcommand{\hclbadgesolid}[3][hclblue]{%
  \tcbox[
    on line,
    nobeforeafter,
    enhanced,
    tcbox raise base,
    colback=#1,
    colframe=#1,
    boxrule=0.55pt,
    arc=8pt, outer arc=8pt,
    left=6pt, right=6pt, top=1.6pt, bottom=0pt,
    fontupper=\footnotesize\sffamily\bfseries\color{white},
  ]{\href{#3}{\color{white}\strut#2}}%
}

%---------------------------------------------------------------------------
% Section heading styles (blue bar before number, mirrors website .section)
%---------------------------------------------------------------------------
\titleformat{\section}
  {\normalfont\fontsize{16pt}{19pt}\selectfont\bfseries\color{hclink}}
  {\textcolor{hclblue}{\rule[-.06em]{0.26em}{1.05em}}\hspace{0.5em}\thesection}{0.55em}{}
\titleformat{\subsection}
  {\normalfont\fontsize{14pt}{17pt}\selectfont\bfseries\color{hclinksoft}}
  {\textcolor{hclbluesoft}{\thesubsection}}{0.55em}{}
\titleformat{\subsubsection}
  {\normalfont\fontsize{10pt}{12pt}\selectfont\itshape\bfseries\color{hclinksoft}}
  {\thesubsubsection}{0.55em}{}
\titlespacing*{\section}{0pt}{1.9\baselineskip}{0.8\baselineskip}
\titlespacing*{\subsection}{0pt}{1.0\baselineskip}{0.35\baselineskip}
\titlespacing*{\subsubsection}{0pt}{0.8\baselineskip}{0.3\baselineskip}

%---------------------------------------------------------------------------
% Caption style
%---------------------------------------------------------------------------
\captionsetup{
  font={small},
  labelfont={bf,color=hclblue},
  labelsep=period,
  format=plain,
  justification=justified,
  singlelinecheck=true
}

%---------------------------------------------------------------------------
% Abstract box (outlined rectangle, pale blue bg)
%---------------------------------------------------------------------------
\newtcolorbox{hclAbstract}{
  enhanced,
  breakable,
  colback=hclbgsoft,
  colframe=hclline,
  boxrule=0.4pt,
  arc=6pt,
  left=14pt, right=14pt, top=8pt, bottom=11pt,
  borderline west={3pt}{0pt}{hclblue},
  before skip=8pt, after skip=14pt,
  fontupper=\normalsize,
}

% Smaller info box (e.g. for notes / disclaimers)
\newtcolorbox{hclNote}{
  enhanced,
  breakable,
  colback=hclbgalt,
  colframe=hclline,
  boxrule=0.4pt,
  arc=4pt,
  left=10pt, right=10pt, top=6pt, bottom=6pt,
  borderline west={2pt}{0pt}{hclgold},
  before skip=8pt, after skip=8pt,
  fontupper=\small\color{hclinksoft},
}

%---------------------------------------------------------------------------
% Page styles
%---------------------------------------------------------------------------
% Running pages (hclmain): DELIBERATELY MORE SUBTLE than the title page.
% The title page is the "front door" and uses big logos + centre tagline;
% subsequent pages just need a quiet reminder of provenance so they don't
% compete with the body text. Hence: small logos, no centre tagline, a
% hairline rule, and generous breathing room before the body content.
\fancypagestyle{hclmain}{%
  \fancyhf{}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
  \ifhcl@nologos\else
    \fancyhead[L]{%
      \begin{tikzpicture}[remember picture, overlay]
        % University mark — bigger than the previous tiny version, still
        % clearly subordinate to the title page lockup.
        \node[anchor=west, inner sep=0pt]
          at ($(current page.north west)+(2.1cm,-0.7cm)$)
          {\includegraphics[height=0.72cm]{\hcl@universitylogo}};
        % HCL mark; trim removes transparent padding from the supplied PNG.
        \node[anchor=east, inner sep=0pt]
          at ($(current page.north east)+(-2.1cm,-0.7cm)$)
          {\includegraphics[height=0.55cm,trim={250bp 266bp 226bp 244bp},clip]{\hcl@hcllogo}};
        % Hairline blue rule hugging the bottom of the logos
        \draw[hclblue, line width=0.4pt]
          ($(current page.north west)+(2.1cm,-1.25cm)$) --
          ($(current page.north east)+(-2.1cm,-1.25cm)$);
      \end{tikzpicture}%
    }
  \fi
  \fancyfoot[L]{\footnotesize\color{hclmuted}\sffamily\hcl@reporttag}
  \fancyfoot[R]{\footnotesize\color{hclmuted}\sffamily\thepage\,/\,\pageref{LastPage}}
}

% Title page: same logos drawn by \maketitleHCL, simpler footer.
\fancypagestyle{hclfirst}{%
  \fancyhf{}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
  \fancyfoot[L]{\footnotesize\color{hclmuted}\sffamily\hcl@reporttag}
  \fancyfoot[R]{\footnotesize\color{hclmuted}\sffamily\thepage\,/\,\pageref{LastPage}}
}

\pagestyle{hclmain}

%---------------------------------------------------------------------------
% Title block
%---------------------------------------------------------------------------
\newcommand{\maketitleHCL}{%
  \thispagestyle{hclfirst}%
  % --- Top logos drawn relative to the page ---
  % Both logos centered on a shared y-line via anchor=west / anchor=east,
  % aligning the HKUST(GZ) wordmark and the HCL lab logo.
  \ifhcl@nologos\else
    \begin{tikzpicture}[remember picture, overlay]
      % Left: HKUST(GZ) vector logo, converted from logo/HKUST-GZ.svg
      \node[anchor=west, inner sep=0pt]
        at ($(current page.north west)+(2.1cm,-0.85cm)$)
        {\includegraphics[height=1.1cm,keepaspectratio]{\hcl@universitylogo}};
      % Right: HCL mark, cropped in layout and aligned to the right margin.
      \node[anchor=east, inner sep=0pt]
        at ($(current page.north east)+(-2.1cm,-0.85cm)$)
        {\includegraphics[height=0.85cm,trim={250bp 266bp 226bp 244bp},clip]{\hcl@hcllogo}};
      % Center: single light watermark tag (just the lab name),
      % positioned slightly above the divider, hugging it from above.
      \node[anchor=south, inner sep=0pt, align=center]
        at ($(current page.north)+(0,-1.5cm)$)
        {\sffamily\color{hcllinestrong}%
         \fontsize{8.5pt}{10pt}\selectfont\bfseries%
         \MakeUppercase{\hcl@headertop}};
      % Blue divider drawn directly in the overlay, hugging the logos
      \draw[hclblue, line width=0.6pt]
        ($(current page.north west)+(2.1cm,-1.55cm)$) --
        ($(current page.north east)+(-2.1cm,-1.55cm)$);
    \end{tikzpicture}%
  \fi
  % Body content starts right after the divider (top margin = 1.7cm,
  % divider at y = 1.55cm -> ~1.5mm visual gap to eyebrow line below).
  \vspace*{0pt}

  % --- Eyebrow tag (small caps, blue) ---
  {\noindent\sffamily\footnotesize\bfseries
   \color{hclblue}\MakeUppercase{\hcl@eyebrow}\par}

  \vspace{0.7em}

  % --- Title ---
  \begingroup
    \setlength{\parskip}{0pt}
    \setlength{\parindent}{0pt}
    \raggedright
    {\fontsize{22pt}{26pt}\selectfont\bfseries\color{hclink}%
     \hcl@papertitle\par}
    \ifdefempty{\hcl@papersubtitle}{}{%
      \vspace{0.45em}
      {\fontsize{14pt}{18pt}\selectfont\itshape\color{hclmuted}%
       \hcl@papersubtitle\par}%
    }
  \endgroup

  \vspace{1.1em}

  % --- Authors ---
  \ifdefempty{\hcl@authors}{}{%
    {\noindent\large\color{hclinksoft}\hcl@authors\par}
    \vspace{0.55em}
  }

  % --- Affiliations ---
  \ifdefempty{\hcl@affil}{}{%
    {\noindent\small\color{hclmuted}\hcl@affil\par}
    \vspace{0.3em}
  }

  % --- Notes (equal contribution, corresponding, etc.) ---
  \ifdefempty{\hcl@notes}{}{%
    {\noindent\footnotesize\color{hclmutedtwo}\itshape\hcl@notes\par}
    \vspace{0.55em}
  }

  % --- Badges row ---
  \ifdefempty{\hcl@badges}{}{%
    \vspace{0.45em}
    {\centering\setlength{\fboxsep}{0pt}\hcl@badges\par}
    \vspace{0.55em}
  }

  % --- Optional teaser figure ---
  \ifdefempty{\hcl@teaser}{}{%
    \vspace{0.7em}
    {\hcl@teaser\par}
  }

  \vspace{0.55em}
}

%---------------------------------------------------------------------------
% Section helper: \keywords{kw1, kw2, ...}
%---------------------------------------------------------------------------
\newif\ifhcl@firstkeyword
\newcommand{\hcl@keyworditem}[1]{%
  \ifhcl@firstkeyword
    \global\hcl@firstkeywordfalse
  \else
    \hspace{0.7em}{\color{hcllinestrong}\raisebox{0.12ex}{\scriptsize\textbullet}}\hspace{0.7em}%
  \fi
  #1%
}
\newcommand{\keywords}[1]{%
  \par\vspace{0.65em}\noindent
  {\color{hclblue}\rule{2pt}{1.15em}}\hspace{0.6em}%
  {\sffamily\footnotesize\bfseries\color{hclblue}Keywords}%
  \hspace{0.9em}%
  \hcl@firstkeywordtrue
  {\sffamily\footnotesize\color{hclmuted}\forcsvlist{\hcl@keyworditem}{#1}}%
  \par\vspace{0.65em}
}

